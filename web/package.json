{
  "name": "omnistream-for-codex-web",
  "version": "1.0.0-rc3",
  "description": "Local OmniStream WebRTC panel source for Codex",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "format": "npx prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "node ./tests/panel-contract.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@nvidia/ov-web-rtc": "6.6.0"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.9.6",
    "prettier-plugin-brace-style": "0.7.3",
    "ts-node": "10.9.2",
    "vite": "6.4.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.18.1",
    "npm": ">=10.2.3"
  }
}
