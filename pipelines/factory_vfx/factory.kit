[package]
title = "FireViewer Factory VFX Qualification"
version = "1.0.0"
description = "Bounded Isaac Sim / Flow / PhysX / Replicator laboratory"

[dependencies]
"isaacsim.simulation_app" = {}
"omni.kit.loop-isaac" = {}
"omni.usd" = {}
"omni.usd.schema.flow" = {}
"omni.hydra.rtx" = {}
"omni.kit.viewport.window" = {}
"omni.physics.physx" = {}
"omni.physics.stageupdate" = {}
"omni.physx" = {}
"omni.replicator.core" = {}
"omni.warp.core" = {}
"omni.flowusd" = {}

[settings]
app.name = "FireViewer Factory VFX"
app.version = "1.0.0"
app.settings.persistent = false
app.settings.fabricDefaultStageFrameHistoryCount = 3
app.content.emptyStageOnStart = true
app.file.ignoreUnsavedOnExit = true
app.vulkan = true
renderer.asyncInit = false
renderer.gpuEnumeration.glInterop.enabled = false
omni.replicator.asyncRendering = false
rtx-transient.dlssg.enabled = false
exts."omni.kit.renderer.core".present.enabled = false
exts."omni.usd".locking.onClose = false
