#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 600
    timeCodesPerSecond = 60
    framesPerSecond = 60
)
# Original project-owned demonstration. No external references or textures.
# Run with omni.physx enabled. Ball is dynamic; Marker is keyframed, not a body.
def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 9.81
    }
    def Cube "Floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 2
        bool physics:collisionEnabled = true
        double3 xformOp:translate = (0, -0.25, 0)
        float3 xformOp:scale = (6, 0.25, 6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.16, 0.19, 0.21)]
    }
    def Sphere "Ball" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        double radius = 0.5
        bool physics:rigidBodyEnabled = true
        bool physics:kinematicEnabled = false
        bool physics:collisionEnabled = true
        float physics:mass = 1
        vector3f physics:velocity = (0, 0, 0)
        double3 xformOp:translate = (0, 4, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.46, 0.73, 0.04)]
    }
    def Cube "Marker"
    {
        double size = 0.8
        double3 xformOp:translate.timeSamples = {0: (-3, 0.5, 0), 120: (-3, 2, 0), 240: (-3, 0.5, 0)}
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.32, 0.48, 0.7)]
    }
    def Camera "Camera"
    {
        float focalLength = 24
        float2 clippingRange = (0.1, 1000)
        double3 xformOp:translate = (8, 6, 10)
        float3 xformOp:rotateXYZ = (-20, 35, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    def DistantLight "KeyLight"
    {
        float inputs:intensity = 3500
        float inputs:angle = 0.53
        float3 xformOp:rotateXYZ = (-35, -25, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def DomeLight "FillLight"
    {
        float inputs:intensity = 300
        color3f inputs:color = (0.65, 0.75, 1)
    }
}
